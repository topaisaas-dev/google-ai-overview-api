{
  "openapi": "3.0.3",
  "info": {
    "title": "Google AI Overview & SGE SERP Extractor API",
    "version": "1.0.0",
    "description": "Ultra-fast, production-grade extraction engine for Google AI Overviews (SGE), generative summaries, cited source URLs, follow-up queries, organic ranking, and SEO click cannibalization impact. Built for AI agents, RAG pipelines, and SEO intelligence platforms.",
    "contact": {
      "name": "TopAI SaaS Dev",
      "url": "https://github.com/topaisaas-dev"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://google-ai-overview-api.topaisaas.workers.dev",
      "description": "Cloudflare Edge Production Server (Sub-50ms global latency)"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Healthcheck and Edge Status",
        "description": "Returns operational health, Cloudflare edge region, and sub-engine status.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is fully operational.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    },
                    "service": {
                      "type": "string",
                      "example": "google-ai-overview-api"
                    },
                    "version": {
                      "type": "string",
                      "example": "1.0.0"
                    },
                    "timestamp": {
                      "type": "string",
                      "example": "2026-09-20T21:40:00.000Z"
                    },
                    "uptime": {
                      "type": "number",
                      "example": 99.99
                    },
                    "edgeRegion": {
                      "type": "string",
                      "example": "CDG"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/serp/ai-overview": {
      "get": {
        "summary": "Extract Google AI Overview",
        "description": "Targeted endpoint extracting solely the Google AI Overview generative block: summary text, Markdown formatted answer, cited reference source cards with favicons, and follow-up search questions.",
        "operationId": "getAiOverview",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Target search query (e.g. 'what is quantum computing', 'best crm software for startups').",
            "schema": {
              "type": "string",
              "example": "what is quantum computing"
            }
          },
          {
            "name": "gl",
            "in": "query",
            "required": false,
            "description": "Two-letter country code (ISO 3166-1 alpha-2). Defaults to 'us'.",
            "schema": {
              "type": "string",
              "default": "us",
              "example": "us"
            }
          },
          {
            "name": "hl",
            "in": "query",
            "required": false,
            "description": "Two-letter language code (ISO 639-1). Defaults to 'en'.",
            "schema": {
              "type": "string",
              "default": "en",
              "example": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "AI Overview extracted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string",
                      "example": "what is quantum computing"
                    },
                    "country": {
                      "type": "string",
                      "example": "us"
                    },
                    "language": {
                      "type": "string",
                      "example": "en"
                    },
                    "has_ai_overview": {
                      "type": "boolean",
                      "example": true
                    },
                    "overview_type": {
                      "type": "string",
                      "example": "generative_summary"
                    },
                    "text_content": {
                      "type": "string",
                      "example": "Quantum computing harnesses quantum mechanics principles to solve complex problems..."
                    },
                    "markdown_content": {
                      "type": "string",
                      "example": "### Google AI Overview\n\nQuantum computing harnesses quantum mechanics..."
                    },
                    "references": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "position": {
                            "type": "integer",
                            "example": 1
                          },
                          "title": {
                            "type": "string",
                            "example": "Quantum Computing: A Detailed Guide"
                          },
                          "url": {
                            "type": "string",
                            "example": "https://en.wikipedia.org/wiki/Quantum_computing"
                          },
                          "domain": {
                            "type": "string",
                            "example": "wikipedia.org"
                          },
                          "snippet": {
                            "type": "string",
                            "example": "Quantum computing is a rapidly-emerging technology..."
                          },
                          "favicon": {
                            "type": "string",
                            "example": "https://www.google.com/s2/favicons?domain=wikipedia.org&sz=64"
                          }
                        }
                      }
                    },
                    "follow_up_questions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "confidence_score": {
                      "type": "number",
                      "example": 0.95
                    },
                    "extraction_time_ms": {
                      "type": "integer",
                      "example": 42
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing search query parameter."
          }
        }
      }
    },
    "/v1/serp/search": {
      "get": {
        "summary": "Full SERP with AI Overview and Organic Results",
        "description": "Comprehensive SERP extraction combining the generative AI Overview, top 10 organic results, People Also Ask questions, related searches, and Knowledge Panel.",
        "operationId": "getFullSerp",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query string.",
            "schema": {
              "type": "string",
              "example": "benefits of rust programming"
            }
          },
          {
            "name": "gl",
            "in": "query",
            "required": false,
            "description": "Country code. Defaults to 'us'.",
            "schema": {
              "type": "string",
              "default": "us"
            }
          },
          {
            "name": "hl",
            "in": "query",
            "required": false,
            "description": "Language code. Defaults to 'en'.",
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "num",
            "in": "query",
            "required": false,
            "description": "Number of organic results to return (max 20). Defaults to 10.",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Comprehensive SERP returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string",
                      "example": "benefits of rust programming"
                    },
                    "country": {
                      "type": "string",
                      "example": "us"
                    },
                    "language": {
                      "type": "string",
                      "example": "en"
                    },
                    "ai_overview": {
                      "type": "object",
                      "properties": {
                        "has_ai_overview": {
                          "type": "boolean",
                          "example": true
                        },
                        "overview_type": {
                          "type": "string",
                          "example": "generative_summary"
                        },
                        "text_content": {
                          "type": "string",
                          "example": "Rust provides memory safety without garbage collection..."
                        },
                        "references": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "title": { "type": "string" },
                              "url": { "type": "string" },
                              "domain": { "type": "string" }
                            }
                          }
                        }
                      }
                    },
                    "organic_results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "position": {
                            "type": "integer",
                            "example": 1
                          },
                          "title": {
                            "type": "string",
                            "example": "Why Rust is the most loved language"
                          },
                          "url": {
                            "type": "string",
                            "example": "https://stackoverflow.blog/rust"
                          },
                          "domain": {
                            "type": "string",
                            "example": "stackoverflow.blog"
                          },
                          "snippet": {
                            "type": "string",
                            "example": "Rust has been voted the most loved programming language..."
                          },
                          "is_cited_in_ai_overview": {
                            "type": "boolean",
                            "example": true
                          }
                        }
                      }
                    },
                    "people_also_ask": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "related_searches": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "total_organic_results": {
                      "type": "integer",
                      "example": 10
                    },
                    "extraction_time_ms": {
                      "type": "integer",
                      "example": 48
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter."
          }
        }
      }
    },
    "/v1/serp/compare": {
      "get": {
        "summary": "SEO Cannibalization & Citation Overlap Audit",
        "description": "Evaluates whether Google's AI Overview cannibalizes organic traffic from the #1 rank, lists cited domains vs organic leaders, and calculates zero-click traffic disruption risk.",
        "operationId": "compareSerpCannibalization",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query to audit.",
            "schema": {
              "type": "string",
              "example": "stripe vs adyen fees"
            }
          },
          {
            "name": "gl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "us"
            }
          },
          {
            "name": "hl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cannibalization analysis computed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string",
                      "example": "stripe vs adyen fees"
                    },
                    "cannibalization_analysis": {
                      "type": "object",
                      "properties": {
                        "ai_overview_present": {
                          "type": "boolean",
                          "example": true
                        },
                        "is_organic_leader_cited": {
                          "type": "boolean",
                          "example": false
                        },
                        "citation_overlap_pct": {
                          "type": "number",
                          "example": 33.3
                        },
                        "cannibalization_risk": {
                          "type": "string",
                          "example": "HIGH"
                        },
                        "traffic_impact_assessment": {
                          "type": "string",
                          "example": "Organic leader #1 is not cited in AI Overview."
                        }
                      }
                    },
                    "organic_leader": {
                      "type": "object",
                      "properties": {
                        "title": { "type": "string" },
                        "url": { "type": "string" },
                        "domain": { "type": "string" }
                      }
                    },
                    "cited_domains": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}